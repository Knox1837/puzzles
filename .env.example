# Needed for online play in production (Vercel). Not needed for local development:
# without these, rooms are kept in memory by the running dev server.
# Option A: Upstash Redis (Vercel Marketplace adds this automatically).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Option B: any standard Redis server, e.g. Redis Cloud (Vercel Marketplace adds this automatically).
# Used only when the Upstash variables above are not set.
REDIS_URL=
